# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Azure (source discovery) -------------------------------------------------
# Uses DefaultAzureCredential. For a service principal, set these three; for
# local dev you can instead run `az login` and leave them blank.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Source database credentials ---------------------------------------------
# Azure SQL / MS SQL login used across discovered servers (or override per-server
# in the config file). Use a least-privilege read-only login.
SRC_MSSQL_USER=
SRC_MSSQL_PASSWORD=

# Azure Database for PostgreSQL login.
SRC_PG_USER=
SRC_PG_PASSWORD=

# --- Target: Supabase (single Postgres database) -----------------------------
# Project ref is in config (migration.yaml). Only the DB password is a secret.
# Find it in: Supabase Dashboard -> Project Settings -> Database -> Connection string.
SUPABASE_DB_PASSWORD=

# Optional: full override of the target connection string. If set, it wins over
# the host/password assembled from the project ref.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.mmbxootqppuvriodzetb.supabase.co:5432/postgres
